  textComponent: {fileID: 1746345535}
  lines:
  - 'General Dane: What are you doing in the room room? '
  - 'LadyLuck: I had noise, I came to check it out '
  - 'General Dane: Well the cadets need susper vision'
  - 'LadyLuck: Yes Im on my way, why do all the screens say no siginal?'
  - 'General Dane: We undergoing techinal screenings, so they down for the week.
    I''ll be on my way now please return to your post '
  - 'LadyLuck: Yes Great General Dane!!'
  roomline: 0
  textSpeed: 0.3
